# Additional fstab — fallback if vendor fstab doesn't provide all /data entries
# Pre-mounted by init.recovery.mt6761.rc to bypass vendor fstab flags

# Userdata partition (crypto flags removed — no TW_INCLUDE_CRYPTO)
/dev/block/by-name/userdata    /data    f2fs    noatime,nosuid,nodev,discard    wait,check,formattable,resize,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fscompress
