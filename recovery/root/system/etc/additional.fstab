# Additional fstab — fallback if vendor fstab doesn't provide all /data entries
# (The real fix is recovery.fstab without latemount; this is a safety net)

# Userdata partition (simplified mount flags, no vendor-specific options)
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,reserve_root=134217,resgid=1065 wait,check,formattable,resize,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption
